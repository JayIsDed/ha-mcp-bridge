# Home Assistant REST API base URL (no trailing slash).
HA_URL=http://192.168.8.127:8123

# Long-lived access token from HA: Settings → Profile → Security → Long-Lived Access Tokens.
# Treat as a secret — store in Infisical for any deployed instance; this file is gitignored for local dev.
HA_TOKEN=

# Optional: cap the history window the tool will accept. Default 168h (1 week).
HA_HISTORY_MAX_HOURS=168

# Optional: request timeout in seconds.
HA_HTTP_TIMEOUT=15

# InfluxDB 2.x for analytical queries. Read-only scope recommended.
# Bucket access expected: `homeassistant` (HA state history) + `sensors` (homelab sensors).
INFLUX_URL=http://192.168.8.112:8086
INFLUX_TOKEN=
INFLUX_ORG=homelab
INFLUX_HTTP_TIMEOUT=30

# Per-tool response cap in bytes. Oversize responses block Linux's 64KB stdio pipe
# buffer and hang the MCP transport — guard returns a structured error instead.
HA_MCP_MAX_RESPONSE_BYTES=120000

# Optional: file path for full DEBUG log. Default is WARNING-to-stderr only.
# HA_MCP_DEBUG_LOG=/tmp/ha-mcp-bridge.log

# ha_call_service allowlist (default-deny — both must be set to enable the tool).
# Patterns are comma-separated fnmatch globs. See README for semantics.
# Example for plant shelf actuation:
# HA_MCP_ALLOWED_SERVICES=light.*,switch.turn_on,switch.turn_off,switch.toggle,fan.*,scene.turn_on
# HA_MCP_ALLOWED_ENTITY_PATTERNS=*plant_shelf*,light.grow_*,switch.grow_*,fan.grow_*
HA_MCP_ALLOWED_SERVICES=
HA_MCP_ALLOWED_ENTITY_PATTERNS=
