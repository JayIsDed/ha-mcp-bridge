# Home Assistant REST API base URL (no trailing slash).
HA_URL=http://192.168.8.127:8123

# Long-lived access token from HA: Settings → Profile → Security → Long-Lived Access Tokens.
# Treat as a secret — store in Infisical for any deployed instance; this file is gitignored for local dev.
HA_TOKEN=

# Optional: cap the history window the tool will accept. Default 168h (1 week).
HA_HISTORY_MAX_HOURS=168

# Optional: request timeout in seconds.
HA_HTTP_TIMEOUT=15
